# Astro
dist/
.astro/

# Brainstorming companion
.superpowers/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.production

# OS
.DS_Store

# Editors
.idea/
.vscode/

# Fetcher caches — regenerated on every build, not worth versioning.
#
# NOTE: this must be `data/*`, not `data/`. Excluding the directory itself
# stops git from ever descending into it, which silently makes every negation
# below do nothing.
data/*
# The override and exclusion files that used to live here are gone. They were
# a patch log replayed after each build because the fetchers wiped the content
# directory; corrections now live in src/content/talks/*.yaml, which nothing
# rewrites. See docs/superpowers/specs/2026-09-19-content-pipeline-inversion-design.md.
# Generated, but versioned anyway: it is the only copy of each video's title,
# date and description outside the YouTube API, and CI has no API key. Without
# it a CI build writes no entry for a video it cannot date, so link-recordings
# has nothing to fold into the engagement and every talk-override keyed on that
# video reports "override unused". The deployed site then showed eighteen
# recordings' worth of conferences as bare event names with no video, no slides
# and no session title, while the local build looked right.
!data/youtube-cache.json
# Same reason, different file: the contribution heatmap reads this at build
# time. It used to be generated during the CI build, because the fetchers ran
# there; the build no longer fetches anything, so an uncommitted copy means CI
# renders "GitHub activity unavailable". The nightly refresh updates it.
!data/github.json

# Deck PDFs are mirrored from noti.st at ~8MB each and grow with every talk;
# they are hosted rather than versioned. See src/lib/deckHost.ts.
public/decks/*.pdf
# Title-slide renders used as talk thumbnails, hosted under decks/covers/.
public/decks/covers/*

# Images inside blog posts. Hosted under the bucket's blog/ prefix and
# referenced as /blog-images/<file>; see src/lib/blogHost.ts.
public/blog-images/*

# Cloudflare/wrangler artifacts (just in case)
.wrangler/

# Full-resolution photo originals — hosted alongside the decks, not versioned.
# public/speakers holds the local mirror you sync from. See src/lib/photoHost.ts.
public/speakers/*
!public/speakers/.gitkeep

# Speaker photo display masters. Uploaded to the bucket's photos/display/
# prefix and fetched by Astro at build time; see src/lib/photoHost.ts.
src/assets/speakers/*
!src/assets/speakers/.gitkeep

# Credly badge art. Mirrored to the bucket's badges/ prefix; see
# src/lib/badgeHost.ts.
src/assets/badges/*
!src/assets/badges/.gitkeep
photos-fullres/
