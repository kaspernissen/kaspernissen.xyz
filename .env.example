# One bucket serves both decks and photo originals, separated by prefix:
#
#   s3://kasper-nissen-presentations/decks/*.pdf
#   s3://kasper-nissen-presentations/photos/*.jpg
#
# Unset either base URL to serve that kind from the repo instead
# (public/decks/ and public/speakers/).

PUBLIC_DECK_BASE_URL=https://kasper-nissen-presentations.s3.eu-west-1.amazonaws.com/decks
PUBLIC_PHOTO_BASE_URL=https://kasper-nissen-presentations.s3.eu-west-1.amazonaws.com/photos
PUBLIC_BADGE_BASE_URL=https://kasper-nissen-presentations.s3.eu-west-1.amazonaws.com/badges

# Upload target for scripts/sync-decks.mjs. The prefix comes from the npm
# script (decks:sync / photos:sync), not from here.
DECKS_BUCKET=s3://kasper-nissen-presentations

# Named profile for the least-privilege IAM upload user.
AWS_PROFILE=kasper-personal
AWS_REGION=eu-west-1
