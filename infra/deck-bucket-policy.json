{
  "Version": "2012-10-17",
  "Id": "PublicReadPublishedAssets",
  "Statement": [
    {
      "Sid": "AllowPublicReadOfPublishedPrefixes",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::kasper-nissen-presentations/decks/*",
        "arn:aws:s3:::kasper-nissen-presentations/photos/*",
        "arn:aws:s3:::kasper-nissen-presentations/badges/*"
      ]
    }
  ]
}
