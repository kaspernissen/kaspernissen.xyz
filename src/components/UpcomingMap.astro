---
import type { CollectionEntry } from 'astro:content';
import { WORLD_LAND_PATH } from '../lib/worldLand';
import { cityFor } from '../lib/cities';

const { entries, past = [] } = Astro.props as {
  entries: CollectionEntry<'talks'>[];
  /** Places already spoken at, drawn as faint dots behind the upcoming pins. */
  past?: CollectionEntry<'talks'>[];
};



type Stop = { name: string; date: string };
type Pin = { label: string; lat: number; lon: number; events: Stop[] };

const unplaced: string[] = [];

function group(list: CollectionEntry<'talks'>[], collectUnplaced: boolean) {
  const pins = new Map<string, Pin>();
  for (const e of list) {
    // The event name is a second chance at the city, not a worse one. Most
    // engagements have no location at all — a YouTube entry never does — and
    // the GitHub README parser splits "ServiceMeshCon North America 2022,
    // Detroit, USA" at the wrong comma, leaving the city in the event name and
    // "USA" as the location. Both cases put the pin back on the map.
    const city = cityFor(e.data.location, e.data.event);
    if (!city) {
      // Report by whatever names the engagement, so an entry with no location
      // is visible here instead of silently missing from the map.
      if (collectUnplaced) unplaced.push(e.data.location || e.data.event);
      continue;
    }
    const pin = pins.get(city.label) ?? { ...city, events: [] };
    pin.events.push({ name: e.data.event, date: e.data.date.toISOString().slice(0, 10) });
    pins.set(city.label, pin);
  }
  for (const pin of pins.values()) pin.events.sort((a, b) => a.date.localeCompare(b.date));
  return pins;
}

const pins = group(entries, true);
// A city that is also an upcoming stop is drawn once, as an upcoming pin — the
// faint dot underneath would just make it look smudged.
const pastPins = new Map([...group(past, false)].filter(([label]) => !pins.has(label)));

// Equirectangular projection onto a 360x180 viewBox — matches the source SVG
// world map's own projection, so pins land where they should.
const project = (lat: number, lon: number) => ({ x: lon + 180, y: 90 - lat });

const placed = [...pins.values()].map((p) => ({ ...p, ...project(p.lat, p.lon) }));
const placedPast = [...pastPins.values()].map((p) => ({ ...p, ...project(p.lat, p.lon) }));
// Both sets drive the crop, so a city that only appears in the past history
// (Tokyo, Atlanta) isn't quietly cropped out of the frame.
const allPlaced = [...placed, ...placedPast];

// Crop the viewBox to the pins rather than always drawing the whole globe —
// otherwise most of the card is empty ocean and polar region. Padded, clamped
// to world bounds, and given a minimum span so two nearby cities don't zoom in
// so far that the result stops reading as a map.
const PAD = 14;
const MIN_W = 120;
const MIN_H = 70;
const xs = allPlaced.map((p) => p.x);
const ys = allPlaced.map((p) => p.y);
let vx = Math.min(...xs) - PAD;
let vy = Math.min(...ys) - PAD;
let vw = Math.max(...xs) - Math.min(...xs) + PAD * 2;
let vh = Math.max(...ys) - Math.min(...ys) + PAD * 2;
if (vw < MIN_W) { vx -= (MIN_W - vw) / 2; vw = MIN_W; }
if (vh < MIN_H) { vy -= (MIN_H - vh) / 2; vh = MIN_H; }
vx = Math.max(0, Math.min(vx, 360 - vw));
vy = Math.max(0, Math.min(vy, 180 - vh));
const viewBox = `${vx} ${vy} ${vw} ${vh}`;

// Radii and strokes are in viewBox units, so they must scale with the crop or
// a zoomed-in map renders comically fat pins. 360 is the un-cropped width.
const scale = vw / 360;
const pinR = 2 * scale;
const stroke = 0.4 * scale;
---
{placed.length > 0 && (
  <div class="bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] p-4 overflow-hidden">
    <div class="flex items-baseline justify-between mb-3">
      <div class="text-sm font-bold">Where I'll be</div>
      <div class="text-xs text-stone-500">{`${placed.length} ${placed.length === 1 ? 'city' : 'cities'}`}</div>
    </div>

    <div class="overflow-x-auto relative" data-map-wrap>
      <div
        data-map-tip
        hidden
        class="pointer-events-none absolute z-30 max-w-[15rem] rounded-lg bg-stone-950/95 px-2.5 py-1.5 text-[11px] leading-snug text-stone-100 shadow-lg ring-1 ring-stone-700"
      ></div>
      <svg
        viewBox={viewBox}
        class="w-full h-auto min-w-[520px]"
        role="img"
        aria-label={`Map of upcoming speaking locations: ${placed.map((p) => p.label).join(', ')}`}
      >
        {/* Landmasses — Natural Earth 110m, pre-projected to this exact 360x180
            equirectangular viewBox by scripts/gen-world-path.mjs. */}
        <path
          d={WORLD_LAND_PATH}
          fill="#292524"
          stroke="#44403c"
          stroke-width={stroke}
          stroke-linejoin="round"
        />

        {/* Graticule at 30° intervals, drawn over the land at low contrast */}
        <g stroke="#57534e" stroke-width={stroke} fill="none" opacity="0.35">
          {[-60, -30, 30, 60].map((lat) => (
            <line x1="0" y1={90 - lat} x2="360" y2={90 - lat} />
          ))}
          {[-120, -60, 0, 60, 120].map((lon) => (
            <line x1={lon + 180} y1="0" x2={lon + 180} y2="180" />
          ))}
        </g>
        <line x1="0" y1="90" x2="360" y2="90" stroke="#57534e" stroke-width={stroke} opacity="0.5" />

        {/* Been-there dots first, so an upcoming pin always draws on top. */}
        {placedPast.map((p) => (
          <g
            class="map-stop cursor-default"
            data-label={p.label}
            data-kind="past"
            data-events={JSON.stringify(p.events)}
          >
            {/* Generous invisible hit area — the visible dot is ~1px at this scale. */}
            <circle cx={p.x} cy={p.y} r={pinR * 2.4} fill="transparent" />
            <circle cx={p.x} cy={p.y} r={pinR * 0.62} fill="#a8a29e" opacity="0.55" />
            <title>{p.label}</title>
          </g>
        ))}

        {placed.map((p) => (
          <g
            class="map-stop cursor-default"
            data-label={p.label}
            data-kind="upcoming"
            data-events={JSON.stringify(p.events)}
          >
            <circle cx={p.x} cy={p.y} r={pinR * 2.4} fill="#fb923c" opacity="0.22" />
            <circle cx={p.x} cy={p.y} r={pinR} fill="#fb923c" />
            <title>{p.label}</title>
          </g>
        ))}
      </svg>
    </div>

    <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-400">
      {placed.map((p) => (
        <span>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-orange-400 mr-1 align-middle"></span>
          {p.label}
          {p.events.length > 1 && <span class="text-stone-600"> ×{p.events.length}</span>}
        </span>
      ))}
    </div>
    {placedPast.length > 0 && (
      <div class="mt-2 text-[11px] text-stone-500">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-stone-400/60 mr-1 align-middle"></span>
        {placedPast.length} more {placedPast.length === 1 ? 'city' : 'cities'} spoken at — hover a dot for details
      </div>
    )}
    {unplaced.length > 0 && (
      <div class="mt-2 text-[10px] text-stone-600">
        Not mapped: {[...new Set(unplaced)].join(', ')}
      </div>
    )}
  </div>
)}

<script>
  // Small hover card naming the city and each event held there, with its date.
  // SVG's native <title> tooltip is kept underneath for touch and screen
  // readers; this just makes it legible and instant on a pointer.
  document.querySelectorAll<HTMLElement>('[data-map-wrap]').forEach((wrap) => {
    const tip = wrap.querySelector<HTMLElement>('[data-map-tip]');
    if (!tip) return;

    const show = (stop: SVGGElement, ev: MouseEvent) => {
      let events: { name: string; date: string }[] = [];
      try {
        events = JSON.parse(stop.dataset.events ?? '[]');
      } catch {
        return;
      }
      const label = stop.dataset.label ?? '';
      const upcoming = stop.dataset.kind === 'upcoming';
      tip.innerHTML =
        `<div class="font-semibold ${upcoming ? 'text-orange-300' : 'text-stone-200'}">${label}</div>` +
        events
          .map((e) => `<div class="text-stone-400"><span class="tabular-nums">${e.date}</span> · ${e.name}</div>`)
          .join('');
      tip.hidden = false;
      move(ev);
    };

    const move = (ev: MouseEvent) => {
      const box = wrap.getBoundingClientRect();
      // Flip to the left near the right edge so the card never leaves the card.
      const x = ev.clientX - box.left + wrap.scrollLeft;
      const y = ev.clientY - box.top;
      const flip = x + tip.offsetWidth + 16 > wrap.scrollLeft + box.width;
      tip.style.left = `${flip ? x - tip.offsetWidth - 12 : x + 12}px`;
      tip.style.top = `${Math.max(0, y - tip.offsetHeight - 8)}px`;
    };

    wrap.querySelectorAll<SVGGElement>('.map-stop').forEach((stop) => {
      stop.addEventListener('mouseenter', (ev) => show(stop, ev as MouseEvent));
      stop.addEventListener('mousemove', (ev) => move(ev as MouseEvent));
      stop.addEventListener('mouseleave', () => { tip.hidden = true; });
    });
  });
</script>
