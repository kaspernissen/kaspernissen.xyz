---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { photoDisplayUrl } from '../lib/photoHost';

const { entries } = Astro.props as { entries: CollectionEntry<'speakers'>[] };
---
<div class="relative -mx-6">
  <div
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-3 px-6 scroll-pl-6 scroll-smooth"
    style="scrollbar-color: #fb923c #1c1917;"
  >
    {entries.map((entry) => {
      const d = entry.data;
      return (
        <figure class="snap-start shrink-0 w-72 md:w-96 bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] overflow-hidden">
          <Image
            src={photoDisplayUrl(d.src)}
            alt={d.caption}
            inferSize
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 384px, 288px"
            class="w-full aspect-[4/3] object-cover"
          />
          <figcaption class="p-3 text-xs text-stone-300">
            <div class="font-semibold text-stone-50 line-clamp-1">{d.caption}</div>
            <div class="text-stone-500 mt-0.5">{d.event}{d.event !== 'TBD' && d.date ? ` · ${d.date.toISOString().slice(0, 7)}` : ''}</div>
          </figcaption>
        </figure>
      );
    })}
  </div>
  {/* Right-edge fade indicator that there's more to scroll */}
  <div class="pointer-events-none absolute top-0 right-0 h-full w-12 bg-gradient-to-l from-[var(--color-bg)] to-transparent"></div>
</div>
