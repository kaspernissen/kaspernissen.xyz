---
import SocialLinks from './SocialLinks.astro';
const buildTime = new Date().toISOString();
---
<footer class="max-w-5xl mx-auto px-6 py-10 text-xs text-stone-500 border-t border-stone-800 mt-20 flex flex-wrap gap-3 justify-between">
  <div>© {new Date().getUTCFullYear()} Kasper Nissen.</div>
  <SocialLinks variant="compact" />
  <div title={buildTime}>last built: {buildTime.slice(0, 10)}</div>
</footer>
