---
// Hero text + Memphis-pop decorations. The cartoon is rendered separately by
// the page so it can overflow this section into the GitHub heatmap below.
import SocialLinks from './SocialLinks.astro';
import HeroCartoon from './HeroCartoon.astro';
---
<section class="relative pt-6 pb-4 md:pb-6 overflow-visible">
  {/* Anchored to this section's bottom edge — see HeroCartoon.astro. */}
  <HeroCartoon />
  {/* Confetti / decoration layer */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <span class="absolute top-2 left-[24%] w-3 h-3 rounded-full bg-cyan-400"></span>
    <span class="absolute top-10 right-[40%] w-4 h-4 rounded-full bg-pink-500"></span>
    <span class="absolute top-1/3 left-[5%] w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
    <svg class="absolute top-6 left-[36%] hidden md:block" width="58" height="20" viewBox="0 0 58 20">
      <path d="M2 10 Q10 2 18 10 T34 10 T50 10 L56 10" stroke="#7c3aed" stroke-width="3.5" fill="none" stroke-linecap="round" />
    </svg>
  </div>

  {/* Two-column on desktop. The right column is reserved space so the absolutely-positioned
      cartoon (rendered by the page) doesn't collide with the headline / pills. */}
  <div class="grid grid-cols-1 md:grid-cols-[1fr_20rem] lg:grid-cols-[1fr_26rem] gap-4 md:gap-6 items-end">
    <div class="max-w-3xl pt-4">
      {/* 5xl rather than 6xl: "Platform Engineering" is long, and at 6xl the
          headline wraps far enough to collide with the cartoon column. */}
      {/* 3xl on phones: "Platform Engineering" as one non-wrapping highlighted
          span is wider than a 390px viewport at 4xl, which pushed the whole
          page into horizontal overflow. */}
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.08] text-stone-50">
        Hi, I'm
        <span class="inline-block bg-pink-500 text-white px-2 py-0.5 rounded -rotate-1">Kasper</span>.<br />
        I talk
        <span class="inline-block bg-orange-400 text-stone-950 px-2 py-0.5 rounded rotate-[1.5deg]">Observability</span>,
        <span class="inline-block bg-cyan-400 text-stone-950 px-2 py-0.5 rounded -rotate-1">Platform Engineering</span>
        &amp;
        <span class="inline-block bg-yellow-400 text-stone-950 px-2 py-0.5 rounded rotate-[1.5deg]">AI</span>.
      </h1>
      <p class="mt-6 text-stone-300 text-lg max-w-xl">
        Director of Developer Relations at Dash0. CNCF, MergeForward &amp; AAIF
        Ambassador. Golden Kubestronaut. Cloud Native Nordics co-founder.
      </p>
      <SocialLinks variant="pills" />
    </div>
    {/* Spacer for the desktop layout so flow content reserves room next to the absolutely-positioned cartoon. */}
    <div class="hidden md:block"></div>
  </div>
</section>
