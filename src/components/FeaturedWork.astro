---
// The longer-form work — a book and a course — as cards above the article list.
//
// Laid out sideways: a book cover is portrait, and giving it the full width of
// a card made it tower over everything else on the page. Held to a narrow
// column with the text beside it, the cards stay the height of their text and
// the two sit level however differently shaped their art is.
//
// `object-contain`, not `object-cover` — a course promo is landscape where a
// book cover is portrait, and cropping both to one box cuts the titles off.
import type { CollectionEntry } from 'astro:content';
import TalkThumb from './TalkThumb.astro';

const { entries } = Astro.props as { entries: CollectionEntry<'writing'>[] };
---
{entries.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {entries.map((w) => (
      <a
        href={w.data.url}
        target="_blank"
        rel="noreferrer"
        class="flex items-start gap-4 bg-stone-900 rounded-xl p-4 shadow-[3px_3px_0_0_#44403c] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#44403c] transition"
      >
        <div class="shrink-0 w-20 sm:w-24">
          {w.data.image ? (
            <img
              src={w.data.image}
              alt=""
              loading="lazy"
              class="w-full h-auto rounded shadow-lg shadow-stone-950/60"
            />
          ) : (
            <div class="rounded overflow-hidden">
              <TalkThumb seed={w.data.title} label="" />
            </div>
          )}
        </div>
        {/* min-w-0 lets a long title wrap instead of forcing the card wider. */}
        <div class="min-w-0">
          <div class="text-[11px] uppercase tracking-wider text-stone-500">
            {w.data.kind} · {w.data.publication}
            {w.data.duration_min ? ` · ${w.data.duration_min} min` : ''}
          </div>
          <div class="font-bold mt-1 leading-snug">{w.data.title}</div>
          {w.data.summary && (
            <p class="text-sm text-stone-400 mt-2 leading-relaxed">{w.data.summary}</p>
          )}
        </div>
      </a>
    ))}
  </div>
)}
