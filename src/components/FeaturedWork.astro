---
// The longer-form work — a book and a course — as cards above the article list.
//
// Cover art is `object-contain` on its own ground rather than `object-cover`:
// a book cover is portrait (462x636) and a course promo is landscape, and
// cropping either to a uniform box cuts the title off. Entries with no usable
// cover fall back to the same generated artwork the talk and podcast cards use,
// so the row stays even.
import type { CollectionEntry } from 'astro:content';
import TalkThumb from './TalkThumb.astro';

const { entries } = Astro.props as { entries: CollectionEntry<'writing'>[] };
---
{entries.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {entries.map((w) => (
      <a
        href={w.data.url}
        target="_blank"
        rel="noreferrer"
        class="flex flex-col bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#44403c] transition overflow-hidden"
      >
        {w.data.image ? (
          <div class="bg-stone-950/60 flex items-center justify-center aspect-video">
            <img
              src={w.data.image}
              alt=""
              loading="lazy"
              class="max-h-full max-w-full object-contain"
            />
          </div>
        ) : (
          <TalkThumb seed={w.data.title} label={w.data.kind} />
        )}
        <div class="p-4">
          <div class="text-[11px] uppercase tracking-wider text-stone-500">
            {w.data.kind} · {w.data.publication}
            {w.data.duration_min ? ` · ${w.data.duration_min} min` : ''}
          </div>
          <div class="font-bold mt-1 leading-snug">{w.data.title}</div>
          {w.data.summary && (
            <p class="text-sm text-stone-400 mt-2 leading-relaxed">{w.data.summary}</p>
          )}
        </div>
      </a>
    ))}
  </div>
)}
