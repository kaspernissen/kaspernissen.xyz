---
// One engagement in a schedule listing. Reads from the unified `talks`
// collection — the same entry that, once delivered, carries the deck and the
// recording.
//
// A card rather than a table row, matching BlogRow: twelve conference names
// stacked as lines of text is a wall, and the event's own mark is the fastest
// way to find one in the list.
import type { CollectionEntry } from 'astro:content';
import { talkSlug } from '../lib/slug';
import { isDelivered } from '../lib/engagement';
import EventLogo from './EventLogo.astro';

const { entry } = Astro.props as { entry: CollectionEntry<'talks'> };
const d = entry.data;

const dateStr = d.end_date
  ? `${d.date.toISOString().slice(0, 10)} → ${d.end_date.toISOString().slice(0, 10)}`
  : d.date.toISOString().slice(0, 10);

const roleColors: Record<string, string> = {
  speaker: 'bg-orange-400 text-stone-950',
  keynote: 'bg-pink-500 text-stone-50',
  'co-chair': 'bg-amber-400 text-stone-950',
  organiser: 'bg-emerald-500 text-stone-950',
  moderator: 'bg-violet-500 text-stone-50',
  panelist: 'bg-cyan-400 text-stone-950',
  mc: 'bg-sky-500 text-stone-950',
  attendee: 'bg-stone-700 text-stone-200',
};

// A delivered engagement links to its own page (video, slides, photos); an
// upcoming one links out to the session or the event site.
const delivered = isDelivered(entry);
const href = delivered
  ? `/talks/${d.slug ?? talkSlug(d.title ?? d.event, d.date)}`
  : d.session_url ?? d.event_url ?? '#';
---
<a
  href={href}
  class="group flex items-start gap-4 rounded-xl bg-stone-900/60 border border-stone-800 p-3 sm:p-4
         hover:-translate-y-0.5 hover:border-stone-700 hover:shadow-[5px_5px_0_0_#44403c] transition"
>
  <EventLogo event={d.event} />
  <div class="min-w-0 flex-1">
    {/* Event name leads; the role sits out on the right so the left edge of
        every card is the thing you scan for. */}
    <div class="flex items-start gap-3">
      <span class="font-semibold text-stone-50 group-hover:text-white">
        {d.event}
        {d.youtube_id && <span class="text-stone-500 ml-1.5" title="Recording available">▶</span>}
        {d.deck_file && <span class="text-stone-500 ml-1.5" title="Slides available">▤</span>}
      </span>
      <span
        class={`ml-auto shrink-0 text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full font-semibold ${roleColors[d.role] ?? roleColors.speaker}`}
      >{d.role}</span>
    </div>
    {d.title && <div class="text-stone-300 italic text-sm mt-1 leading-snug">{d.title}</div>}
    <div class="text-stone-500 text-xs mt-1.5">
      {d.co_speakers.length > 0 && <span>with {d.co_speakers.join(', ')} · </span>}
      {dateStr}{d.location ? ` · ${d.location}` : ''}
    </div>
  </div>
</a>
