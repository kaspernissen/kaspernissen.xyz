---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { talkSlug } from '../lib/slug';
import { displayTitle } from '../lib/engagement';
import { photoDisplayUrl } from '../lib/photoHost';
import { deckCoverUrl } from '../lib/deckHost';
import GeneratedThumb from './GeneratedThumb.astro';

// `photo` is optional: a caller that has not done the photo join just omits it
// and the card behaves as it always did.
const { entry, photo = null } = Astro.props as {
  entry: CollectionEntry<'talks'>;
  photo?: CollectionEntry<'speakers'> | null;
};
const slug = entry.data.slug ?? talkSlug(displayTitle(entry.data), entry.data.date);

// Four ways to picture a talk, best first. The recording's still is the most
// informative. Without one, the deck's title slide names the talk outright,
// then a photo of Kasper actually giving it, then generated art — nine
// delivered talks have no recording and five of those have photographs, which
// were only ever shown on the talk's own page.
const thumb = entry.data.youtube_id
  ? `https://i.ytimg.com/vi/${entry.data.youtube_id}/hqdefault.jpg`
  : null;
const dateStr = entry.data.date.toISOString().slice(0, 10);

// Said plainly, because a photograph where a video still usually goes reads as
// "there is a recording here" otherwise.
const missing = entry.data.deck_file ? 'slides only' : 'no recording';
---
<a
  href={`/talks/${slug}`}
  class="block bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#44403c] transition group overflow-hidden"
>
  {thumb ? (
    <img src={thumb} alt="" loading="lazy" class="w-full aspect-video object-cover" />
  ) : entry.data.deck_cover ? (
    <div class="relative">
      <Image
        src={deckCoverUrl(entry.data.deck_cover)}
        alt=""
        inferSize
        widths={[400, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        class="w-full aspect-video object-cover"
      />
      <span class="absolute bottom-2 left-2 rounded-full bg-stone-950/80 px-2 py-0.5 text-[10px] uppercase tracking-wider text-stone-300">
        {missing}
      </span>
    </div>
  ) : photo ? (
    <div class="relative">
      <Image
        src={photoDisplayUrl(photo.data.src)}
        alt={photo.data.caption}
        inferSize
        widths={[400, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
        class="w-full aspect-video object-cover"
      />
      <span class="absolute bottom-2 left-2 rounded-full bg-stone-950/80 px-2 py-0.5 text-[10px] uppercase tracking-wider text-stone-300">
        {missing}
      </span>
    </div>
  ) : (
    <GeneratedThumb seed={displayTitle(entry.data)} label={missing} />
  )}
  <div class="p-4">
    <div class="text-[11px] uppercase tracking-wider text-stone-500">{entry.data.event} · {dateStr}</div>
    <div class="font-bold mt-1 leading-snug">{displayTitle(entry.data)}</div>
    {entry.data.deck_file && (
      <div class="mt-2 inline-flex items-center gap-1 text-[11px] text-stone-400">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        slides
      </div>
    )}
  </div>
</a>
