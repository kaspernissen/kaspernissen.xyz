---
import type { CollectionEntry } from 'astro:content';
import { blogSlug, readingMinutes } from '../lib/blog';

// A post written here, in a list of writing that otherwise links away. Same
// shape as WritingRow so the two sit in one list, but marked as staying on the
// site: an orange rule down the left and its own chip.
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { title, date } = entry.data;
const mins = readingMinutes(entry.body ?? '');
---
<a
  href={`/blog/${blogSlug(entry)}`}
  class="flex flex-wrap items-baseline gap-3 py-3 border-b border-stone-800 border-l-2 border-l-orange-400 bg-orange-400/5 hover:bg-stone-800 -mx-2 px-2 rounded"
>
  <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full font-semibold bg-stone-50 text-stone-950">on this site</span>
  <span class="font-semibold text-stone-50">{title}</span>
  <span class="text-stone-300">— kaspernissen.xyz</span>
  <span class="text-stone-500 text-sm ml-auto">
    {date.toISOString().slice(0, 10)} · {mins} min read
  </span>
</a>
