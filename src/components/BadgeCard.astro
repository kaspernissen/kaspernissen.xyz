---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { badgeUrl } from '../lib/badgeHost';

const { entry } = Astro.props as { entry: CollectionEntry<'badges'> };
const d = entry.data;
---
<a
  href={d.url}
  class="block bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] p-4 text-center hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#44403c] transition"
>
  {/* Badge art is remote (see src/lib/badgeHost.ts). Credly renders these at a
      fixed square, so the size is declared rather than inferred — that saves a
      network round trip per badge at build time. */}
  <Image
    src={badgeUrl(d.image)}
    alt={d.name}
    width={120}
    height={120}
    class="mx-auto"
  />
  <div class="mt-3 font-bold text-sm leading-tight">{d.name}</div>
  <div class="text-xs text-stone-400 mt-1">{d.issuer}</div>
  <div class="text-[10px] text-stone-500 mt-1">issued {d.issued.toISOString().slice(0, 7)}</div>
</a>
