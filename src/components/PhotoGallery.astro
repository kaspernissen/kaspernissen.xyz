---
// A tight, caption-free grid for the photos attached to one engagement.
//
// PhotoCard is the right shape on /speaker-kit, where each photo is an asset
// you pick and download. On a talk page the photos are illustration: the event,
// date and credit are already in the page header, so repeating them under every
// tile is noise. The download stays, as a hover affordance on the tile itself.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { photoUrl } from '../lib/photoHost';

const { entries } = Astro.props as { entries: CollectionEntry<'speakers'>[] };

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/speakers/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

function resolve(src: string) {
  const filename = src.replace(/^\.\//, '').replace(/^src\/assets\/speakers\//, '');
  const key = Object.keys(images).find((k) => k.endsWith('/' + filename));
  return key ? images[key].default : null;
}

const tiles = entries.map((e) => ({ entry: e, img: resolve(e.data.src) }));
---
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
  {tiles.map(({ entry, img }) => (
    <a
      href={photoUrl(entry.data.download)}
      class="group relative block rounded-lg overflow-hidden bg-stone-900"
      title={`${entry.data.caption} — download original`}
    >
      {img ? (
        <Image
          src={img}
          alt={entry.data.caption}
          widths={[300, 600]}
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
          class="w-full aspect-[4/3] object-cover transition group-hover:scale-[1.03] group-hover:opacity-90"
        />
      ) : (
        <div class="w-full aspect-[4/3] bg-orange-950 flex items-center justify-center text-stone-500 text-xs">
          photo missing
        </div>
      )}
      <span
        class="absolute bottom-1.5 right-1.5 flex items-center gap-1 rounded-full bg-stone-950/75 px-2 py-1 text-[10px] font-semibold text-stone-100 opacity-0 transition group-hover:opacity-100"
      >
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        original
      </span>
    </a>
  ))}
</div>
