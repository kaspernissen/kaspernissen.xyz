---
import fs from 'node:fs';
import path from 'node:path';

type Day = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 };
type Data = { total: number; days: Day[] } | null;

let data: Data = null;
try {
  const raw = fs.readFileSync(path.resolve('data/github.json'), 'utf8');
  data = JSON.parse(raw);
} catch {
  data = null;
}

const cellSize = 11;
const gap = 3;
// GitHub-style green ramp; level-0 sits at stone-800 — visible against the
// stone-900 card surface but quieter than the previous stone-700.
const colors = ['#292524', '#0e4429', '#006d32', '#26a641', '#39d353'];

const cols: (Day | null)[][] = [];
if (data && data.days.length > 0) {
  const days = data.days.slice(-371);
  const first = new Date(days[0].date + 'T00:00:00Z');
  const padFront = first.getUTCDay();
  const padded: (Day | null)[] = [...Array(padFront).fill(null), ...days];
  for (let i = 0; i < padded.length; i += 7) cols.push(padded.slice(i, i + 7));
}
const width = cols.length * (cellSize + gap);
const height = 7 * (cellSize + gap);
const cells = cols.flatMap((col, ci) =>
  col.flatMap((d, ri) => (d ? [{ d, x: ci * (cellSize + gap), y: ri * (cellSize + gap) }] : [])),
);
---
{data && data.days.length > 0 ? (
  <div class="bg-stone-900 rounded-xl shadow-[3px_3px_0_0_#44403c] p-4">
    <div class="flex items-baseline justify-between mb-2">
      <div class="text-sm font-bold">GitHub activity</div>
      <a
        href="https://github.com/kaspernissen"
        class="text-xs text-stone-500 hover:text-stone-100"
      >
        @kaspernissen · {data.total} contributions
      </a>
    </div>
    <svg
      viewBox={`0 0 ${width} ${height}`}
      class="w-full h-auto"
      role="img"
      aria-label="GitHub contribution heatmap"
    >
      {/* One shared cell, placed with <use> and coloured by its level's group:
          spelling out width, height, rx and fill on 365 rects made this the
          heaviest thing on the home page after the map. Empty days get no
          tooltip; "0 contributions" told nobody anything. */}
      <defs><rect id="hm-cell" width={cellSize} height={cellSize} rx="2" /></defs>
      {colors.map((fill, level) => (
        <g fill={fill}>
          {cells.filter((c) => c.d.level === level).map(({ d, x, y }) =>
            d.count > 0 ? (
              <use href="#hm-cell" x={x} y={y}><title>{d.date}: {d.count} contribution{d.count === 1 ? '' : 's'}</title></use>
            ) : (
              <use href="#hm-cell" x={x} y={y} />
            ),
          )}
        </g>
      ))}
    </svg>
  </div>
) : (
  <div class="bg-stone-900 rounded-xl p-4 text-sm text-stone-500">
    GitHub activity unavailable.
  </div>
)}
