---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WritingRow from '../components/WritingRow.astro';
import PostRow from '../components/PostRow.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import { isPodcast, isNewsletter } from '../lib/writingKinds';
import { published } from '../lib/blog';
import { writingFeed } from '../lib/writingFeed';
import { abs, collectionPage, PERSON_ID } from '../lib/person';
import { blogSlug } from '../lib/blog';

// Podcast and interview appearances live on /podcasts — they are talking, not
// writing, and 13 of them buried the blog posts here.
const newest = (a, b) => +b.data.date - +a.data.date;
const all = (await getCollection('writing')).filter((w) => !isPodcast(w.data.kind));

// The book and the course are the two pieces someone is most likely to have
// come here for, and a one-line row sells neither. They lead, as cards.
const FEATURED_KINDS = ['book', 'course'];
const featured = all.filter((w) => FEATURED_KINDS.includes(w.data.kind)).sort(newest);
// Posts written here are interleaved with the ones published elsewhere.
const articles = writingFeed(
  all.filter((w) => !isNewsletter(w.data.kind) && !FEATURED_KINDS.includes(w.data.kind)),
  published(await getCollection('blog')),
);
// Code RED issues are numbered, and their publish dates don't always run in
// issue order. Sorted by title with a numeric-aware compare, so #37 leads and
// #10 doesn't sort before #9.
const byIssue = (a, b) =>
  b.data.title.localeCompare(a.data.title, undefined, { numeric: true });
const newsletters = all.filter((w) => isNewsletter(w.data.kind)).sort(byIssue);

// The book and the course as what they are, then every piece in page order.
const SCHEMA_TYPE = { book: 'Book', course: 'Course' };
const jsonLd = collectionPage('/writing/', 'Writing by Kasper Borg Nissen', [
  ...featured.map((w) => ({
    name: w.data.title,
    url: w.data.url,
    type: SCHEMA_TYPE[w.data.kind],
    extra: { author: { '@id': PERSON_ID }, ...(w.data.kind === 'course' ? { provider: { '@type': 'Organization', name: w.data.publication } } : { publisher: { '@type': 'Organization', name: w.data.publication } }) },
  })),
  ...articles.map((w) =>
    w.type === 'post'
      ? { name: w.entry.data.title, url: abs(`/blog/${blogSlug(w.entry)}`) }
      : { name: w.entry.data.title, url: w.entry.data.url },
  ),
]);
---
<BaseLayout
  title="Writing — Kasper Nissen"
  description="Articles, guides, the Code RED newsletter, a book and a course by Kasper Borg Nissen on observability, OpenTelemetry and platform engineering."
  current="/writing/"
  jsonLd={jsonLd}
>
  <PageHeader chip="Writing" chipClass="bg-pink-500 text-white">
      A book, a course, and {articles.length} posts and guides, newest first —
      podcast appearances are on <a href="/podcasts/" class="underline decoration-orange-400 decoration-2 underline-offset-4 hover:text-stone-50">the podcasts page</a>.
    </PageHeader>
  {featured.length > 0 && (
    <section class="mt-8">
      <FeaturedWork entries={featured} />
    </section>
  )}

  <div class="mt-10">
    {articles.map((w) => (w.type === 'post' ? <PostRow entry={w.entry} /> : <WritingRow entry={w.entry} />))}
  </div>

  {newsletters.length > 0 && (
    <section class="mt-16">
      <h2 class="text-2xl font-extrabold tracking-tight">Code RED newsletter</h2>
      <p class="text-stone-400 mt-2 text-sm">
        {newsletters.length} issues, latest first.
      </p>
      <div class="mt-6">
        {newsletters.map((w) => <WritingRow entry={w} />)}
      </div>
    </section>
  )}
</BaseLayout>
