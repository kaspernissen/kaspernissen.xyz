---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { talkSlug } from '../../lib/slug';
import { assignPhotos } from '../../lib/photoJoin';
import { deckCoverUrl, deckUrl } from '../../lib/deckHost';
import { displayTitle, isDelivered, isCancelled, visible } from '../../lib/engagement';
import { cleanAbstract, metaDescription } from '../../lib/talkText';
import { abs, breadcrumbs, PERSON_ID } from '../../lib/person';

export async function getStaticPaths() {
  const talks = visible(await getCollection('talks'));
  const photos = await getCollection('speakers');

  // A photo names its event where it can and falls back to its date where it
  // can't — see src/lib/photoJoin.ts for why the date alone isn't enough.
  const galleries = assignPhotos(talks, photos);

  return talks.map((entry) => {
    const slug = entry.data.slug ?? talkSlug(displayTitle(entry.data), entry.data.date);
    return { params: { slug }, props: { entry, gallery: galleries.get(entry) ?? [] } };
  });
}

const { entry, gallery } = Astro.props;
const d = entry.data;
const title = displayTitle(d);
const dateStr = d.date.toISOString().slice(0, 10);
const delivered = isDelivered(entry);
const abstract = cleanAbstract(d.abstract);
const slug = Astro.params.slug;
const path = `/talks/${slug}`;
const url = abs(path);

// Twenty-odd talks have no abstract yet. An empty description is worse than a
// plain factual one: the engine then writes its own from whatever text it
// finds first on the page.
const lead = d.role === 'co-chair' || d.role === 'organiser' || d.role === 'mc' || d.role === 'attendee'
  ? `Kasper Borg Nissen at ${d.event}`
  : `${title}: ${d.role === 'keynote' ? 'keynote' : 'talk'} by Kasper Borg Nissen at ${d.event}`;
const material = [d.youtube_id && 'Recording', d.deck_file && (d.youtube_id ? 'slides' : 'Slides')].filter(Boolean);
const description = metaDescription(
  abstract ??
    `${lead}${d.location ? `, ${d.location}` : ''}, ${dateStr}.` +
      (material.length ? ` ${material.join(' and ')} available.` : ''),
);

// The title slide when there is one, else the recording's thumbnail, so a share
// shows this talk rather than the site-wide card.
const youtubeThumb = d.youtube_id ? `https://i.ytimg.com/vi/${d.youtube_id}/hqdefault.jpg` : null;
const shareImage = d.deck_cover ? deckCoverUrl(d.deck_cover) : youtubeThumb;

// Event for the session itself, with the recording and the deck hung off it.
// Speaking roles are performers; running the event is organising it.
const speaking = ['speaker', 'keynote', 'moderator', 'panelist', 'mc'].includes(d.role);
const organising = d.role === 'co-chair' || d.role === 'organiser';
const jsonLd: Record<string, unknown>[] = [];
if (d.role !== 'attendee') {
  jsonLd.push({
    '@type': 'Event',
    '@id': `${url}#event`,
    name: title,
    description: abstract ? metaDescription(abstract, 500) : description,
    startDate: dateStr,
    ...(d.end_date ? { endDate: d.end_date.toISOString().slice(0, 10) } : {}),
    eventStatus: isCancelled(entry) ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
    ...(d.location ? { location: { '@type': 'Place', name: d.location, address: d.location } } : {}),
    url,
    ...(d.session_url ? { sameAs: d.session_url } : {}),
    superEvent: { '@type': 'Event', name: d.event, ...(d.event_url ? { url: d.event_url } : {}) },
    ...(speaking
      ? { performer: [{ '@id': PERSON_ID }, ...d.co_speakers.map((name) => ({ '@type': 'Person', name }))] }
      : {}),
    ...(organising ? { organizer: { '@id': PERSON_ID } } : {}),
    ...(shareImage ? { image: shareImage } : {}),
    ...(d.tags.length ? { keywords: d.tags } : {}),
    ...(d.youtube_id || d.deck_file
      ? {
          subjectOf: [
            ...(d.youtube_id ? [{ '@id': `${url}#video` }] : []),
            ...(d.deck_file ? [{ '@id': `${url}#slides` }] : []),
          ],
        }
      : {}),
  });
}
if (d.youtube_id) {
  jsonLd.push({
    '@type': 'VideoObject',
    '@id': `${url}#video`,
    name: title,
    description: abstract ? metaDescription(abstract, 500) : description,
    thumbnailUrl: youtubeThumb,
    // The session date stands in for the upload date, which the YouTube import
    // does not keep. Recordings go up within days of the talk.
    uploadDate: dateStr,
    embedUrl: `https://www.youtube-nocookie.com/embed/${d.youtube_id}`,
    contentUrl: `https://www.youtube.com/watch?v=${d.youtube_id}`,
    actor: { '@id': PERSON_ID },
    ...(d.role !== 'attendee' ? { recordedAt: { '@id': `${url}#event` } } : {}),
  });
}
if (d.deck_file) {
  jsonLd.push({
    '@type': 'PresentationDigitalDocument',
    '@id': `${url}#slides`,
    name: `${title} (slides)`,
    url: deckUrl(d.deck_file),
    encodingFormat: 'application/pdf',
    ...(d.deck_cover ? { thumbnailUrl: deckCoverUrl(d.deck_cover) } : {}),
    author: { '@id': PERSON_ID },
    datePublished: dateStr,
    ...(d.notist_url ? { sameAs: d.notist_url } : {}),
  });
}
jsonLd.push(breadcrumbs([['Home', '/'], ['Talks', '/talks'], [title, path]]));
---
<BaseLayout
  title={`${title} — Kasper Nissen`}
  description={description}
  current="/talks/"
  image={shareImage}
  imageAlt={d.deck_cover ? `Title slide of ${title}` : title}
  jsonLd={jsonLd}
>
  <article class="pt-6 max-w-3xl">
    <div class="text-[11px] uppercase tracking-wider text-stone-500">
      {d.event} · {dateStr}{d.location ? ` · ${d.location}` : ''}
      {!delivered && <span class="ml-2 text-orange-400">upcoming</span>}
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight mt-2">{title}</h1>
    {d.co_speakers.length > 0 && <div class="text-stone-400 mt-2">with {d.co_speakers.join(', ')}</div>}

    {/* The recording leads when there is one. Without it, the title slide
        takes its place, so every talk with a deck opens on a picture of it. */}
    {d.youtube_id ? (
      <div class="aspect-video mt-6 rounded-xl overflow-hidden">
        <iframe
          class="w-full h-full"
          src={`https://www.youtube-nocookie.com/embed/${d.youtube_id}`}
          title={title}
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    ) : d.deck_cover && d.deck_file ? (
      <a href={deckUrl(d.deck_file)} class="block mt-6 rounded-xl overflow-hidden ring-1 ring-stone-800 hover:ring-stone-600 transition">
        <Image
          src={deckCoverUrl(d.deck_cover)}
          alt={`Title slide of ${title}`}
          inferSize
          widths={[800, 1600]}
          sizes="(min-width: 768px) 768px, 100vw"
          class="w-full aspect-video object-cover"
        />
      </a>
    ) : null}

    {abstract && <div class="mt-6 prose prose-stone max-w-none whitespace-pre-line">{abstract}</div>}

    {/* With a recording on top, the cover still earns a place as a preview of
        what the download is. */}
    {d.youtube_id && d.deck_cover && d.deck_file && (
      <a href={deckUrl(d.deck_file)} class="block mt-8 w-full sm:w-80 rounded-lg overflow-hidden ring-1 ring-stone-800 hover:ring-stone-600 transition">
        <Image
          src={deckCoverUrl(d.deck_cover)}
          alt={`Title slide of ${title}`}
          inferSize
          widths={[400, 800]}
          sizes="(min-width: 640px) 320px, 100vw"
          class="w-full aspect-video object-cover"
        />
      </a>
    )}

    <div class={`${d.youtube_id && d.deck_cover ? 'mt-3' : 'mt-8'} flex flex-wrap items-center gap-2`}>
      {/* deck_file is a file name; deckUrl resolves it to wherever decks are
          hosted (see src/lib/deckHost.ts). */}
      {d.deck_file && (
        <a
          href={deckUrl(d.deck_file)}
          class="inline-flex items-center gap-1.5 bg-stone-50 text-stone-950 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white transition"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Download slides{d.deck_size_mb ? ` · ${d.deck_size_mb.toFixed(1)} MB` : ''}
        </a>
      )}
      {d.youtube_id && (
        <a
          href={`https://www.youtube.com/watch?v=${d.youtube_id}`}
          class="inline-flex items-center gap-1.5 bg-stone-800 text-stone-100 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-stone-700 transition"
        >Watch on YouTube</a>
      )}
      {(d.session_url || d.event_url) && (
        <a
          href={d.session_url ?? d.event_url}
          class="inline-flex items-center gap-1.5 bg-stone-800 text-stone-100 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-stone-700 transition"
        >{d.session_url ? 'Session page' : 'Event page'}</a>
      )}
      {d.notist_url && (
        <a href={d.notist_url} class="text-xs text-stone-500 hover:text-stone-300 transition">On Notist →</a>
      )}
      {d.tags.map((t) => (
        <span class="bg-amber-400 text-stone-950 rounded-full px-3 py-1 text-xs font-medium">{t}</span>
      ))}
    </div>

  </article>

  {/* Outside the article's max-w-3xl: the grid wants the full column width so
      four photos fit across on a wide screen. */}
  {gallery.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold mb-4">Photos from {d.event}</h2>
      <PhotoGallery entries={gallery} />
    </section>
  )}
</BaseLayout>
