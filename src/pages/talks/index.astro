---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkCard from '../../components/TalkCard.astro';
import { sortTalks } from '../../lib/sortTalks';
import { isDelivered } from '../../lib/engagement';

// Delivered engagements only — upcoming ones live on /conferences until their
// date passes, at which point they appear here and start collecting a deck and
// a recording.
const talks = sortTalks((await getCollection('talks')).filter((t) => isDelivered(t)));
const withVideo = talks.filter((t) => t.data.youtube_id).length;
const withSlides = talks.filter((t) => t.data.deck_file).length;

// Filtering happens in the browser over the already-rendered cards: the whole
// archive is ~90 entries, so shipping them all and hiding some is far simpler
// than building a route per facet, and it keeps every talk in the static HTML
// for search engines.
const years = [...new Set(talks.map((t) => t.data.date.getFullYear()))].sort((a, b) => b - a);
---
<BaseLayout title="Talks — Kasper Nissen" current="/talks">
  <section class="pt-6">
    <h1 class="text-4xl font-extrabold tracking-tight">Talks</h1>
    <p class="text-stone-400 mt-2">
      Conference, meetup, and podcast appearances. {talks.length} given —
      {withVideo} with a recording, {withSlides} with slides.
    </p>
  </section>

  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-filters>
    <div class="flex flex-wrap items-center gap-1.5">
      <button type="button" data-year="all" aria-pressed="true" class="filter-chip">All years</button>
      {years.map((y) => (
        <button type="button" data-year={y} aria-pressed="false" class="filter-chip">{y}</button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-1.5">
      <button type="button" data-has="video" aria-pressed="false" class="filter-chip">Has recording</button>
      <button type="button" data-has="slides" aria-pressed="false" class="filter-chip">Has slides</button>
    </div>
  </div>

  <p class="mt-4 text-sm text-stone-500" data-count aria-live="polite"></p>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4" data-talk-grid>
    {talks.map((t) => (
      <div
        data-talk
        data-year={t.data.date.getFullYear()}
        data-video={t.data.youtube_id ? 'true' : 'false'}
        data-slides={t.data.deck_file ? 'true' : 'false'}
      >
        <TalkCard entry={t} />
      </div>
    ))}
  </div>

  <p class="mt-8 text-stone-500 text-sm hidden" data-empty>
    No talks match those filters.
  </p>
</BaseLayout>

<style>
  /* Plain CSS rather than @apply: a Tailwind 4 component style block would
     need an @reference to resolve utilities, and these are three rules. */
  .filter-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-stone-700, #44403c);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-stone-300, #d6d3d1);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .filter-chip:hover {
    border-color: var(--color-stone-500, #78716c);
    color: var(--color-stone-50, #fafaf9);
  }
  .filter-chip[aria-pressed='true'] {
    background: var(--color-stone-50, #fafaf9);
    border-color: var(--color-stone-50, #fafaf9);
    color: var(--color-stone-950, #0c0a09);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-talk]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (root && cards.length) {
    let year = 'all';
    // "Has recording" and "has slides" combine: picking both narrows to talks
    // that have both, which is the reading people expect from two toggles.
    const has = new Set<string>();

    const press = (el: Element, on: boolean) =>
      el.setAttribute('aria-pressed', String(on));

    function apply() {
      let shown = 0;
      for (const card of cards) {
        const okYear = year === 'all' || card.dataset.year === year;
        const okHas =
          (!has.has('video') || card.dataset.video === 'true') &&
          (!has.has('slides') || card.dataset.slides === 'true');
        const visible = okYear && okHas;
        card.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === cards.length ? '' : `Showing ${shown} of ${cards.length} talks`;
      }
      empty?.classList.toggle('hidden', shown > 0);
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;

      if (btn.dataset.year) {
        year = btn.dataset.year;
        for (const b of root.querySelectorAll('[data-year]')) press(b, b === btn);
      } else if (btn.dataset.has) {
        const key = btn.dataset.has;
        if (has.has(key)) has.delete(key);
        else has.add(key);
        press(btn, has.has(key));
      }
      apply();
    });

    apply();
  }
</script>
