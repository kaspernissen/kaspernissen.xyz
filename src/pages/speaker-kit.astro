---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoCard from '../components/PhotoCard.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import { sortPhotos } from '../lib/sortPhotos';
import { abs, bio, bioTitle, PERSON_ID, WEBSITE_ID } from '../lib/person';

const photos = sortPhotos(await getCollection('speakers'));

// The two cut-out headshots, which are a different thing from the gallery
// below: those are shots of Kasper on stage that an organiser might use in a
// programme, these are the square portrait a conference site wants for a
// speaker tile. They live beside the other artwork in the bucket rather than
// in the speakers collection so they stay out of the photo grid.
const ART = 'https://kasper-nissen-presentations.s3.eu-west-1.amazonaws.com/photos/art';
const headshots = [
  { src: `${ART}/headshot-cyan.png`, alt: 'Kasper Nissen, square headshot on a cyan background' },
  { src: `${ART}/headshot-red.jpg`, alt: 'Kasper Nissen, square headshot on a red background' },
];

// An organiser writing a programme wants the longer-form work in one place,
// not spelt out in the bio. Read from the collection so it can never drift
// from /writing.
const longForm = (await getCollection('writing'))
  .filter((w) => w.data.kind === 'book' || w.data.kind === 'course')
  .sort((a, b) => +b.data.date - +a.data.date);

// Kasper's canonical bio — one version, kept in sync with what he submits to
// events. There were three (short/medium/long); three near-identical
// paragraphs is three chances to be out of date, and an organiser only ever
// copies one. It lives in src/lib/person.ts because the schema.org Person
// every page emits describes him with the same words.

// Grounded in talks Kasper actually gives — every line here matches something
// on /talks — so an organiser reading this can go and watch one.
const topics = [
  'Observability as a foundation for AI-enabled platforms',
  'Observability for AI: making agents and LLM-backed systems debuggable',
  'AI for observability: where it genuinely helps, and where it misleads',
  'Rethinking observability as a platform product, not a platform feature',
  'Beyond "supports OpenTelemetry": judging how mature that support really is',
  'OpenTelemetry in production: from zero to insight',
];
---
<BaseLayout
  title="Speaker kit — Kasper Nissen"
  description="Bio, headshots and talk topics for event organisers booking Kasper Borg Nissen, Director of Developer Relations at Dash0."
  current="/speaker-kit/"
  type="profile"
  jsonLd={[
    {
      '@type': 'ProfilePage',
      '@id': `${abs('/speaker-kit')}#webpage`,
      url: abs('/speaker-kit'),
      name: 'Speaker kit — Kasper Borg Nissen',
      mainEntity: { '@id': PERSON_ID },
      isPartOf: { '@id': WEBSITE_ID },
    },
    ...headshots.map((h) => ({
      '@type': 'ImageObject',
      contentUrl: h.src,
      caption: h.alt,
      about: { '@id': PERSON_ID },
    })),
  ]}
>
  <PageHeader chip="Speaker kit" chipClass="bg-cyan-400 text-stone-950">
      Everything you need to invite me to your event. Reach me on
      <a href="https://www.linkedin.com/in/kaspernissen/" class="underline decoration-orange-400 underline-offset-2">LinkedIn</a>.
    </PageHeader>

  <section class="mt-10">
    <div class="bg-stone-900 rounded-xl p-5">
      <div class="text-[11px] uppercase tracking-wider text-stone-500 mb-3">Bio</div>
      {/* Headshots beside the bio on a wide screen, above it on a phone — an
          organiser filling in a speaker form copies both in one pass. */}
      <div class="flex flex-col sm:flex-row sm:items-start gap-5">
        <div class="shrink-0 grid grid-cols-2 sm:grid-cols-1 gap-3 w-full sm:w-32">
          {headshots.map((h) => (
            <a href={h.src} class="block group" title="Download this headshot">
              <Image
                src={h.src}
                alt={h.alt}
                inferSize
                widths={[256, 512]}
                sizes="(min-width: 640px) 128px, 45vw"
                class="w-full aspect-square object-cover rounded-lg shadow-[3px_3px_0_0_#44403c] group-hover:-translate-y-0.5 transition"
              />
            </a>
          ))}
        </div>
        <div class="min-w-0">
          <p class="text-lg font-bold leading-snug">Kasper Borg Nissen</p>
          <p class="text-sm text-stone-400 mt-1 leading-relaxed">{bioTitle}</p>
          <p class="text-sm leading-relaxed mt-4">{bio}</p>
          <p class="text-xs text-stone-500 mt-4">Click a headshot to download it.</p>
        </div>
      </div>
    </div>
  </section>

  {longForm.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold mb-3">Book and course</h2>
      <FeaturedWork entries={longForm} />
    </section>
  )}

  <section class="mt-12">
    <h2 class="text-xl font-bold mb-3">Topics I'm happy to speak on</h2>
    <ul class="list-disc pl-6 space-y-1 text-stone-300">
      {topics.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold mb-1">Photos</h2>
    <p class="text-stone-400 text-sm mb-4">
      {photos.length} photos from stages and conferences. Scroll for more, and click any photo to download the original.
    </p>
    {photos.length === 0 ? (
      <p class="text-stone-500 text-sm">No photos uploaded yet.</p>
    ) : (
      /* One scrolling row rather than a grid of every photo: four across on a
         wide screen, the rest a swipe away. Images are lazy, so the ones off
         to the side load only when scrolled to. */
      <div class="relative">
        <div
          id="photo-strip"
          class="grid grid-flow-col auto-cols-[45%] sm:auto-cols-[31%] md:auto-cols-[calc((100%-2.25rem)/4)] gap-3 overflow-x-auto snap-x snap-mandatory pt-1 pb-3 pr-6"
          style="scrollbar-color: #fb923c #1c1917;"
        >
          {photos.map((p, i) => (
            <div class="snap-start"><PhotoCard entry={p} index={i} /></div>
          ))}
        </div>
        {/* Arrows page the row four photos at a time. Each fades out at its
            end of the row; swiping and the scrollbar still work without them. */}
        {[
          { dir: -1, side: 'left-0 -translate-x-1/2', label: 'Previous photos', path: 'M15 18l-6-6 6-6' },
          { dir: 1, side: 'right-0 translate-x-1/2', label: 'Next photos', path: 'M9 18l6-6-6-6' },
        ].map((a) => (
          <button
            type="button"
            data-strip-dir={a.dir}
            aria-label={a.label}
            aria-controls="photo-strip"
            class={`absolute top-[calc(50%-0.5rem)] -translate-y-1/2 ${a.side} z-10 flex h-11 w-11 items-center justify-center rounded-full bg-stone-50 text-stone-950 shadow-[3px_3px_0_0_#44403c] transition hover:bg-orange-400 disabled:pointer-events-none disabled:opacity-0`}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.path} /></svg>
          </button>
        ))}
      </div>
    )}
    {/* A different four up front on every visit: shuffle the tiles before
        they are laid out. Without JavaScript the row keeps the build order. */}
    <script is:inline>
      (() => {
        const strip = document.getElementById('photo-strip');
        if (!strip) return;
        const tiles = [...strip.children];
        for (let i = tiles.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
        }
        strip.append(...tiles);

        // Page by the visible width; snap-start lands each page on a tile.
        const buttons = document.querySelectorAll('[data-strip-dir]');
        const update = () => {
          const max = strip.scrollWidth - strip.clientWidth - 2;
          buttons.forEach((b) => {
            b.disabled = b.dataset.stripDir === '-1' ? strip.scrollLeft <= 2 : strip.scrollLeft >= max;
          });
        };
        buttons.forEach((b) =>
          b.addEventListener('click', () =>
            strip.scrollBy({ left: Number(b.dataset.stripDir) * strip.clientWidth, behavior: 'smooth' }),
          ),
        );
        strip.addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      })();
    </script>
  </section>
</BaseLayout>
