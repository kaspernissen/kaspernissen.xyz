---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { sortPhotos } from '../lib/sortPhotos';

const photos = sortPhotos(await getCollection('speakers'));

// An organiser writing a programme wants the longer-form work in one place,
// not spelt out in the bio. Read from the collection so it can never drift
// from /writing.
const longForm = (await getCollection('writing'))
  .filter((w) => w.data.kind === 'book' || w.data.kind === 'course')
  .sort((a, b) => +b.data.date - +a.data.date);

// Kasper's canonical bio — one version, kept in sync with what he submits to
// events. There were three (short/medium/long); three near-identical
// paragraphs is three chances to be out of date, and an organiser only ever
// copies one.
//
// Note "former" on the Co-Chair role: he co-chaired KubeCon + CloudNativeCon
// EU/NA, he does not currently.
const bioTitle =
  'Director of Developer Relations at Dash0, former Co-Chair KubeCon+CloudNativeCon EU/NA, CNCF Ambassador, Golden Kubestronaut, KCD Organizer, Meet-up organizer';
const bio =
  'Kasper is a CNCF, MergeForward, and AAIF Ambassador, former KubeCon+CloudNativeCon Co-Chair, Golden Kubestronaut, KCD Organizer and CNCG Group Organizer. He co-founded Cloud Native Nordics to unite meetups across the region. At Dash0, he helps make observability easy for developers by advocating for better tooling, best practices, and seamless integrations. Bridging observability, AI, and platform engineering, he ensures developers stay productive and gain actionable insights exactly when needed.';

// Grounded in talks Kasper actually gives — every line here matches something
// on /talks — so an organiser reading this can go and watch one.
const topics = [
  'Observability as a foundation for AI-enabled platforms',
  'Observability for AI: making agents and LLM-backed systems debuggable',
  'AI for observability: where it genuinely helps, and where it misleads',
  'Rethinking observability as a platform product, not a platform feature',
  'Beyond "supports OpenTelemetry": judging how mature that support really is',
  'OpenTelemetry in production: from zero to insight',
];
---
<BaseLayout title="Speaker kit — Kasper Nissen" current="/speaker-kit">
  <section class="pt-6">
    <h1 class="text-4xl font-extrabold tracking-tight">Speaker kit</h1>
    <p class="text-stone-400 mt-2">
      Everything you need to invite me to your event. Reach me on
      <a href="https://www.linkedin.com/in/kaspernissen/" class="underline decoration-orange-400 underline-offset-2">LinkedIn</a>.
    </p>
  </section>

  <section class="mt-10">
    <div class="bg-stone-900 rounded-xl p-5">
      <div class="text-[11px] uppercase tracking-wider text-stone-500 mb-3">Bio</div>
      <p class="text-lg font-bold leading-snug">Kasper Borg Nissen</p>
      <p class="text-sm text-stone-400 mt-1 leading-relaxed">{bioTitle}</p>
      <p class="text-sm leading-relaxed mt-4">{bio}</p>
    </div>
  </section>

  {longForm.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold mb-3">Book and course</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {longForm.map((w) => (
          <a
            href={w.data.url}
            target="_blank"
            rel="noreferrer"
            class="block bg-stone-900 rounded-xl p-4 shadow-[3px_3px_0_0_#44403c] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#44403c] transition"
          >
            <div class="text-[11px] uppercase tracking-wider text-stone-500">
              {w.data.kind} · {w.data.publication}
              {w.data.duration_min ? ` · ${w.data.duration_min} min` : ''}
            </div>
            <div class="font-bold mt-1 leading-snug">{w.data.title}</div>
            {w.data.summary && (
              <p class="text-sm text-stone-400 mt-2 leading-relaxed">{w.data.summary}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mt-12">
    <h2 class="text-xl font-bold mb-3">Topics I'm happy to speak on</h2>
    <ul class="list-disc pl-6 space-y-1 text-stone-300">
      {topics.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold mb-3">Photos</h2>
    <p class="text-stone-400 text-sm mb-4">
      Click a photo to download the original. Credit the photographer and use under the listed license.
    </p>
    {photos.length === 0 ? (
      <p class="text-stone-500 text-sm">No photos uploaded yet.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {photos.map((p) => <PhotoCard entry={p} />)}
      </div>
    )}
  </section>
</BaseLayout>
