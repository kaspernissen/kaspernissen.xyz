---
// The schedule view of the unified `talks` collection: everything still to
// come, plus the history below it. Same entries as /talks — that page shows
// what has been delivered and what it produced.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ConferenceRow from '../components/ConferenceRow.astro';
import UpcomingMap from '../components/UpcomingMap.astro';
import { isScheduled, isDelivered, visible } from '../lib/engagement';
import { isMappable } from '../lib/cities';

const all = visible(await getCollection('talks'));

const upcoming = all
  .filter((e) => isScheduled(e))
  .sort((a, b) => +a.data.date - +b.data.date);

// Only entries that name a real place belong in a schedule history — a YouTube
// row whose "event" is a channel name says nothing about where he was. The test
// is whether the map can place it, not whether a location field was filled in:
// most engagements have none, and "CloudNativeCon+KubeCon San Diego 2019" says
// where it was perfectly well.
const past = all
  .filter((e) => isDelivered(e) && isMappable(e.data.location, e.data.event))
  .sort((a, b) => +b.data.date - +a.data.date);
---
<BaseLayout title="Conferences — Kasper Nissen" current="/conferences">
  <PageHeader chip="Conferences" chipClass="bg-yellow-400 text-stone-950">
      Where I'll be next, and where I've been.
    </PageHeader>

  <section class="mt-8">
    <UpcomingMap entries={upcoming} past={past} />
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold mb-2">Upcoming</h2>
    {upcoming.length === 0 ? (
      <p class="text-stone-500 text-sm py-4">Nothing announced yet — check back soon.</p>
    ) : (
      <div>{upcoming.map((c) => <ConferenceRow entry={c} />)}</div>
    )}
  </section>

  {past.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold mb-2">Been there</h2>
      <div>{past.map((c) => <ConferenceRow entry={c} />)}</div>
    </section>
  )}
</BaseLayout>
