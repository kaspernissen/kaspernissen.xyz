---
// Podcast appearances are talking, not writing, so they get their own page
// rather than sitting in the middle of the blog archive. They still live in the
// `writing` collection — one fetcher shape, filtered by kind at render.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PodcastCard from '../components/PodcastCard.astro';
import { PODCAST_KINDS } from '../lib/writingKinds';
import { collectionPage } from '../lib/person';

const items = (await getCollection('writing'))
  .filter((w) => PODCAST_KINDS.includes(w.data.kind))
  .sort((a, b) => +b.data.date - +a.data.date);

const jsonLd = collectionPage(
  '/podcasts/',
  'Podcasts with Kasper Borg Nissen',
  items.map((w) => ({
    name: w.data.title,
    url: w.data.url,
    type: 'PodcastEpisode',
    extra: {
      datePublished: w.data.date.toISOString().slice(0, 10),
      partOfSeries: { '@type': 'PodcastSeries', name: w.data.publication },
    },
  })),
);
---
<BaseLayout
  title="Podcasts — Kasper Nissen"
  description="Podcast guest spots and interviews with Kasper Nissen on cloud native, observability, and platform engineering."
  current="/podcasts/"
  jsonLd={jsonLd}
>
  <PageHeader chip="Podcasts" chipClass="bg-violet-600 text-white">
      Guest spots and interviews. {items.length} total.
    </PageHeader>
  {items.length === 0 ? (
    <p class="text-stone-500 text-sm py-6">Nothing yet.</p>
  ) : (
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((w) => <PodcastCard entry={w} />)}
    </div>
  )}
</BaseLayout>
