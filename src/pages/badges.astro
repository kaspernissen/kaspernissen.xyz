---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BadgeCard from '../components/BadgeCard.astro';
import { collectionPage } from '../lib/person';

const badges = (await getCollection('badges')).sort((a, b) => +b.data.issued - +a.data.issued);

// Each badge is a credential he holds, verifiable at its Credly URL.
const jsonLd = collectionPage(
  '/badges/',
  'Badges and credentials of Kasper Borg Nissen',
  badges.map((b) => ({
    name: b.data.name,
    url: b.data.url,
    type: 'EducationalOccupationalCredential',
    extra: {
      recognizedBy: { '@type': 'Organization', name: b.data.issuer },
      dateCreated: b.data.issued.toISOString().slice(0, 10),
    },
  })),
);
---
<BaseLayout
  title="Badges — Kasper Nissen"
  description="Kasper Borg Nissen's verified credentials: CNCF Ambassador terms, KubeCon co-chair and keynote roles, Golden Kubestronaut and Kubernetes certifications."
  current="/badges/"
  jsonLd={jsonLd}
>
  <PageHeader chip="Badges" chipClass="bg-pink-500 text-white">
      Verified credentials from <a href="https://www.credly.com/users/kasper-nissen" class="underline decoration-orange-400 underline-offset-2">Credly</a>.
    </PageHeader>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mt-8">
    {badges.map((b) => <BadgeCard entry={b} />)}
  </div>
</BaseLayout>
